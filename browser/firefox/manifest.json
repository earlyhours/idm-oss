{
  "manifest_version": 3,
  "name": "IDM Native Integration",
  "version": "0.2.0",
  "description": "Send downloads and detected video sources to the native Omarchy download manager.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "webRequest",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IDM Native"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "idm-native@earlyhours",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
